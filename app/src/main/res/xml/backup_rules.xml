<?xml version="1.0" encoding="utf-8"?><!--
   Backup-Regeln für Geräte vor Android 12 (API < 31).
   Siehe https://developer.android.com/guide/topics/data/autobackup

   Spielstand, Theme und Consent werden gesichert. Der lokale Premium-Cache
   (ch.lottomatchapp.app.premium) wird ausgeschlossen, damit ein Restore kein
   veraltetes Premium-Flag mitbringt; Play Billing validiert ohnehin beim Start.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="ch.lottomatchapp.app.premium.xml" />
</full-backup-content>
