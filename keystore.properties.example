# Vorlage für das Release-Signing. Kopieren nach keystore.properties (gitignored)
# und mit den echten Werten füllen. Es muss derselbe Upload-Keystore sein,
# mit dem die bisherigen Play-Versionen signiert wurden.
#
# storeFile: absoluter Pfad oder relativ zum Projekt-Root, Forward-Slashes.
storeFile=C:/Users/oacada/keystores/lottomatch-release.jks
storePassword=
keyAlias=
keyPassword=
